#!/usr/bin/env bash
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
"$root/scripts/check-forbidden.sh" --staged
command -v gitleaks >/dev/null || { echo "Install the documented pinned gitleaks before committing." >&2; exit 1; }
gitleaks protect --staged --redact --no-banner --config "$root/.gitleaks.toml"
while IFS= read -r -d '' file; do
  case "$file" in
    compose.yml|compose.yaml|docker-compose.yml|docker-compose.yaml|*/compose.yml|*/compose.yaml|*/docker-compose.yml|*/docker-compose.yaml)
      git show ":$file" | node "$root/scripts/check-compose-policy.mjs" --stdin "$file"
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
