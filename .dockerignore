# Only application build inputs enter the image context.
**
!package.json
!package-lock.json
!next.config.ts
!next-env.d.ts
!postcss.config.mjs
!tsconfig.json
!src/
!src/**
!public/
!public/**
!scripts/
!scripts/build-worker.mjs

# Final exclusions also protect secrets nested beneath allowed source directories.
**/.env*
**/*.env
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
**/.ssh
**/.aws
**/.claude
**/.codex
**/.cursor
**/.journal
**/journals
**/fleethub-audit-private
